# CMake qpOASES package configuration
#
# Defines the qpOASES::qpOASES imported target and the following
# compatibility variables:
#   qpOASES_INCLUDE_DIR
#   qpOASES_LIBRARY_DIR
#   qpOASES_LIBRARY
#   qpOASES_LIBRARIES
#   qpOASES_VERSION

@PACKAGE_INIT@

set(qpOASES_VERSION "@PACKAGE_VERSION@")
set_and_check(qpOASES_INCLUDE_DIR "@PACKAGE_INCLUDE_INSTALL_DIR@")
set_and_check(qpOASES_LIBRARY_DIR "@PACKAGE_LIB_INSTALL_DIR@")

find_library(qpOASES_LIBRARY NAMES qpOASES
    PATHS "${qpOASES_LIBRARY_DIR}"
    NO_DEFAULT_PATH)
set(qpOASES_LIBRARIES "${qpOASES_LIBRARY}")

include("${CMAKE_CURRENT_LIST_DIR}/qpOASESTargets.cmake")
check_required_components(qpOASES)
